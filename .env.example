# ==============================================================================
# DGAI — CONFIGURATION DE L'ENVIRONNEMENT (EXEMPLE)
# Copier ce fichier sous le nom .env et adapter les variables selon vos besoins.
# Ne jamais commiter de secrets réels dans Git.
# ==============================================================================

# Environnement d'exécution : development | staging | production | test
DGAI_ENVIRONMENT=development
DGAI_DEBUG=true

# Nom et version du service
DGAI_APP_NAME="DGAI Core"
DGAI_APP_VERSION="0.1.0"

# Configuration Réseau / API
DGAI_HOST=127.0.0.1
DGAI_PORT=8000
DGAI_ENABLE_DOCS=true
DGAI_API_PREFIX="/api/v1"

# CORS (liste JSON d'URLs autorisées)
DGAI_CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Authentification JWT (À changer impérativement en production)
DGAI_SECRET_KEY="change_me_to_a_secure_random_string_in_production"
DGAI_JWT_ALGORITHM="HS256"
DGAI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Protection des requêtes & Quotas
DGAI_MAX_REQUEST_SIZE_BYTES=2097152
DGAI_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Journalisation (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DGAI_LOG_LEVEL=INFO
DGAI_LOG_FORMAT=json

# Stockage et Répertoires
DGAI_DATA_DIR="./data"
DGAI_MODELS_DIR="./models"
DGAI_CHECKPOINTS_DIR="./checkpoints"

# Quotas Sandbox & Exécution (Phase 8)
DGAI_SANDBOX_TIMEOUT_SECONDS=5.0
DGAI_SANDBOX_MAX_MEMORY_MB=512
DGAI_SANDBOX_NETWORK_ENABLED=false
